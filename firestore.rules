rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /meloUsers/{uid} {
      function owner() { return request.auth != null && request.auth.uid == uid; }
      function valid() {
        let record = request.resource.data;
        let data = record.data;
        return record.keys().hasOnly(['data', 'revision'])
          && record.revision is int && record.revision >= 0
          && data.keys().hasAll(['tasks', 'breakBankMinutes', 'sessionCount', 'focusMinutes', 'breakMinutes'])
          && data.keys().hasOnly(['tasks', 'breakBankMinutes', 'sessionCount', 'focusMinutes', 'breakMinutes'])
          && data.tasks is list && data.tasks.size() <= 500
          && data.breakBankMinutes is number && data.breakBankMinutes >= -1000000 && data.breakBankMinutes <= 1000000
          && data.sessionCount is int && data.sessionCount >= 1 && data.sessionCount <= 10000000
          && data.focusMinutes is int && data.focusMinutes >= 1 && data.focusMinutes <= 300
          && data.breakMinutes is int && data.breakMinutes >= 1 && data.breakMinutes <= 120;
      }
      allow get: if owner();
      allow create: if owner() && valid() && request.resource.data.revision == 0;
      allow update: if owner() && valid() && request.resource.data.revision == resource.data.revision + 1;
    }
  }
}
